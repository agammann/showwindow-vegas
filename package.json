{
  "name": "showwindow-vegas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Las Vegas collector visit planner with session-aware hours, group admission, and source evidence.",
  "license": "MIT",
  "author": "agammann",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "compile:sources": "node scripts/compile-sources.mjs",
    "test:model": "node scripts/model-smoke.mjs"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.0" },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
